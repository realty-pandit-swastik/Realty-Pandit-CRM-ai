# Pipecat (panditji-voice) — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API (Gemini Live for voice)
GEMINI_API_KEY=

# Daily.co (legacy fallback path — still referenced by daily_client.py)
DAILY_API_KEY=

# Node backend URL (for caller-lookup and call-ended notifications)
NODE_BACKEND_URL=http://127.0.0.1:7071

# Pipecat HTTP port (Meta webhook endpoint)
PIPECAT_PORT=8765

# Meta WhatsApp Calling API (read in main.py)
# These are typically managed as system env vars set by PM2 / systemd.
# WHATSAPP_PHONE_ID=
# WHATSAPP_SYSTEM_TOKEN=    # preferred over WHATSAPP_TOKEN
# WHATSAPP_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# GlitchTip — Error tracking. Pipecat shares the existing backend GlitchTip
# project (events are filterable by the `service:pipecat` tag set in instrument.py).
# Paste the SAME DSN value used by the backend in /var/www/.../agents/backend/.env.
# Uses the Sentry SDK as wire-compatible transport.
GLITCHTIP_DSN=

# OPTIONAL — set only if you want voice errors in a separate project. When set,
# this overrides GLITCHTIP_DSN above. Leave blank to reuse the backend project.
GLITCHTIP_DSN_PIPECAT=

# Optional: NODE_ENV controls the Sentry environment tag (production / staging).
NODE_ENV=production
