# Environment
NODE_ENV=development
PORT=7071

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/realty_pandit?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp API
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_TOKEN=your_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Vapi (Voice AI)
VAPI_PRIVATE_KEY=your_vapi_key

# JWT Secrets (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
AGENT_JWT_SECRET=

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Cloudinary (for media upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI
GEMINI_API_KEY=

# Google Maps API (for geocoding properties)
GOOGLE_MAPS_API_KEY=

# External Integration API Keys
EXTERNAL_API_KEY=

# 99acres Pull API
NINETY_NINE_ACRES_USERNAME=
NINETY_NINE_ACRES_PASSWORD=
NINETY_NINE_ACRES_API_URL=https://www.99acres.com/99api/v1/getmy99Response/OeAuXClO43hwseaXEQ/uid/

# MagicBricks PUSH API (fixed key from MagicBricks account)
MAGICBRICKS_PUSH_API_KEY=

# Housing.com Pull API (from Housing.com broker registration)
HOUSING_API_KEY=
HOUSING_ACCOUNT_ID=

# Facebook Page & Lead Ads
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_WEBHOOK_VERIFY_TOKEN=

# Instagram API
IG_BUSINESS_ACCOUNT_ID=
IG_APP_ID=
IG_ACCESS_TOKEN=

# Meta Business Portfolio
META_BUSINESS_ID=

# VAPID Keys for PWA Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# GlitchTip — Error tracking (self-hosted at errors.realtypandit.in)
# Uses the Sentry SDK (@sentry/node) as the wire-compatible transport.
GLITCHTIP_DSN=
