# Environment
NODE_ENV=development
PORT=7071

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/realty_pandit?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp API
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_TOKEN=your_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Vapi (Voice AI)
VAPI_PRIVATE_KEY=your_vapi_key

# JWT Secrets (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
AGENT_JWT_SECRET=

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Cloudinary (for media upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI
GEMINI_API_KEY=

# Google Maps API (for geocoding properties)
GOOGLE_MAPS_API_KEY=

# External Integration API Keys
EXTERNAL_API_KEY=

# 99acres Pull API
NINETY_NINE_ACRES_USERNAME=
NINETY_NINE_ACRES_PASSWORD=
NINETY_NINE_ACRES_API_URL=https://www.99acres.com/99api/v1/getmy99Response/OeAuXClO43hwseaXEQ/uid/

# MagicBricks PUSH API (fixed key from MagicBricks account)
MAGICBRICKS_PUSH_API_KEY=

# Housing.com Pull API (from Housing.com broker registration)
HOUSING_API_KEY=
HOUSING_ACCOUNT_ID=

# Facebook Page & Lead Ads
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_WEBHOOK_VERIFY_TOKEN=

# Instagram API
IG_BUSINESS_ACCOUNT_ID=
IG_APP_ID=
IG_ACCESS_TOKEN=

# Meta Business Portfolio
META_BUSINESS_ID=

# VAPID Keys for PWA Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# GlitchTip — Error tracking (self-hosted at errors.realtypandit.in)
# Uses the Sentry SDK (@sentry/node) as the wire-compatible transport.
GLITCHTIP_DSN=

# ─── WhatsApp outbound compliance switches (2026-08-07) ──────────────────────
# Added after outbound hit a ~40% failure rate, driven by Meta error 131049
# ("healthy ecosystem engagement" throttling) — the same signal that preceded the
# July 2026 WABA lock for "Sending spam".
# Convention matches COLD_NUDGE_ENABLED: anything other than the literal string
# "true" means OFF. Unset ⇒ OFF (except INVENTORY_BROADCAST_ENABLED, default ON).

# Master switch for MARKETING-category templates. UTILITY/AUTHENTICATION sends
# (property cards, OTPs, visit confirmations) are unaffected by this.
WA_MARKETING_ENABLED=false

# Hourly silence-based re-engagement engine (services/interaction_engine.ts).
# 24/7, up to 30 sends/run, MARKETING templates on the CLOSED_WON/CLOSED_LOST tail.
INTERACTION_ENGINE_ENABLED=false

# 24h-session keep-alive blast (queues/workers/scheduled_worker.ts).
# ⚠ Keep OFF until after the last_wa_inbound backfill — it selects on exactly that
# column, so backfilling first would fire it at the whole backfilled population.
SESSION_KEEPALIVE_ENABLED=false

# Fan-out of a newly activated listing to matching QUALIFIED deals. Default ON;
# capped at 25 recipients per run.
INVENTORY_BROADCAST_ENABLED=true

# Cold-lead nudges — disabled 2026-07-19 after the WABA lock. Left OFF.
COLD_NUDGE_ENABLED=false

# ─── Instagram / Facebook social replies (2026-08-07) ────────────────────────
# Contextual LLM replies to comments and DMs. OFF by default (`!== 'true'` idiom):
# enable only once real sends are observed succeeding in the logs. On any LLM error
# the proven static template is sent instead — a reply always goes out.
SOCIAL_LLM_REPLIES_ENABLED=false

# Enforce X-Hub-Signature-256 on /webhooks/facebook. Ships as log-only; flip to true
# after confirming a day of clean "[MetaSig] signature OK" logs. Enforcing with a wrong
# FB_APP_SECRET would black-hole every Meta webhook.
META_SIGNATURE_ENFORCE=false
