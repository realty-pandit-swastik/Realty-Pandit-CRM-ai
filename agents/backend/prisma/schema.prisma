// Deal Queries - Partner/Coordinator communication on deals
model DealQuery {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  // Who raised the query
  raised_by_type String // partner_demand, partner_supply, coordinator
  raised_by_id   String // PartnerAgent.id or Agent.id

  subject String
  message String @db.Text
  status  String @default("OPEN") // OPEN, ANSWERED, CLOSED

  // Response
  answered_by_id String?
  answer         String?   @db.Text
  answered_at    DateTime?

