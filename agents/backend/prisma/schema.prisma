generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. TENANTS (Property Dealers)
// ---------------------------------------------------------
model Tenant {
  id            String   @id @default(uuid())
  business_name String
  owner_name    String
  primary_phone String
  email         String?
  website       String?
  timezone      String   @default("Asia/Kolkata")
  status        String   @default("active") // active, suspended
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  contacts      Contact[]
  interactions  Interaction[]
  agents        Agent[]
  tasks         TaskFollowup[]
  whatsapp_msgs WhatsAppMessage[]
  voice_calls   VoiceCall[]
  emails        Email[]
  inventory     Inventory[]
  staff_calls   StaffCall[]
  appointments  Appointment[] // Calendar system appointments
  transactions  Transaction[] // Property deal transactions
  leads         Lead[]

  @@map("tenants")
}

// ---------------------------------------------------------
// 2. CONTACTS (Single Source of Truth)
// ---------------------------------------------------------
model Contact {
  phone_number String @id // E.164 format. PRIMARY IDENTITY.

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  name   String?
  email  String?
  source String  @default("manual") // website, whatsapp, voice, manual, 99acres, magicbricks, housing

  // Contact Classification (PHASE 12: Extended with REAL_ESTATE_BUILDER)
  // Note: PARTNER_AGENT = External marketplace agents
  contact_type ContactType @default(UNKNOWN)

  // Qualification Data
  intent               String? // buy, sell, rent, commercial
  property_type        String? // flat, house, plot
  budget_min           Decimal?
  budget_max           Decimal?
  preferred_location   String?
  // Demand columns DROPPED Phase 5 (2026-05-29):
  //   demand_bhk Int? → demand_schema_values.bhk String
  //   demand_main_category String? → derive from demand_taxonomy_node_id
  //   demand_category String? → derive from demand_taxonomy_node_id
  //   demand_type_slug String? → derive from demand_taxonomy_node_id
  //   demand_amenities Json? → demand_schema_values.amenities
  timeline             String? // immediate, 1-3 months
  demand_budget_type String? // one_time (buy), per_month (rent/lease)

  // Demand-side unification (2026-05-29) — mirror of inventory.specs + inventory.taxonomy_node_id.
  demand_taxonomy_node_id String? // null = "any property type"
  demand_schema_values    Json?   // { bhk: "1", amenities: ["Lift","Power Backup"], "age-of-construction": "1-3 years", … }

  // Area requirements
  area_min  Float? // Minimum area requirement
  area_max  Float? // Maximum area requirement
  area_unit String? // "sqft" or "sqmtr"

  // Classification IDs (linked to PropertyCategory / SubCategory / PropertyType)
  category_id     String? // FK to PropertyCategory
  sub_category_id String? // FK to PropertySubCategory
  type_id         String? // FK to PropertyType

  // Geo location of preferred area (from Google Maps Places Autocomplete)
  preferred_lat Float? // Latitude - used for radius-based property matching
  preferred_lng Float? // Longitude - used for radius-based property matching

  // State Management
  lead_status       String  @default("cold") // cold, warm, hot, closed, lost
  lifecycle_stage   String  @default("NEW") // NEW, QUALIFIED, MATCHED, VISIT_SCHEDULED, VISITED, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  assigned_agent_id String?
  assigned_agent    Agent?  @relation(fields: [assigned_agent_id], references: [id])

  // Lead Verification (auto-created for external leads, null for legacy contacts)
  verification_status  String? // UNVERIFIED | VERIFIED | REJECTED | CONVERTED_PARTNER
  verification_reason  String? // JUST_BROWSING | BANKER_VALUER | WRONG_NUMBER | DUPLICATE | SPAM | PARTNER_AGENT | OTHER
  verification_remarks String?   @db.Text
  verified_by          String? // Agent ID who verified
  verified_at          DateTime?

  // Partner Referral Tracking
  lead_type              String? // DIRECT_OWNER | PARTNER_REFERRAL
  referral_partner_id    String? // PartnerAgent.id (if registered partner)
  referral_partner_name  String? // Free text name (if unregistered partner)
  referral_partner_phone String? // Phone for retroactive linking when partner registers

  last_channel     String? // whatsapp, voice
  last_interaction DateTime?
  next_action_at   DateTime?
  next_action_type String? // whatsapp_missed_call, etc.

  // WhatsApp Session Tracking
  last_wa_inbound DateTime? // Last inbound WhatsApp message timestamp (for 24h session window)

  // Meta Ad Attribution (populated when lead comes from Facebook/Instagram ad)
  meta_ad_id           String? // Facebook ad ID that generated this lead
  meta_campaign_id     String? // Facebook campaign ID
  meta_adset_id        String? // Facebook ad set ID
  meta_campaign_name   String? // Human-readable campaign name (fetched from API)
  meta_ad_creative     String? // Brief description of ad creative (for AI context)
  meta_form_id         String? // Lead form ID (for lead ads)

  // Social Platform IDs (for linking Instagram/Facebook interactions)
  instagram_scoped_id  String? // Instagram-scoped user ID
  facebook_scoped_id   String? // Facebook page-scoped user ID

  // AI Context
  ai_summary         String? @db.Text
  notes              String? @db.Text
  preferred_language String? // english, hindi, hinglish

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  interactions           Interaction[]
  tasks                  TaskFollowup[]
  whatsapp_msgs          WhatsAppMessage[]
  voice_calls            VoiceCall[]
  emails                 Email[]
  lead_score             LeadScore?
  inventory              Inventory[]
  key_holder_properties  Inventory[]             @relation("KeyHolderProperties")
  owned_properties       Inventory[]             @relation("OwnedProperties")
  scheduled_visits       ScheduledVisit[]
  appointments           Appointment[] // Calendar system appointments
  partner_profile        PartnerAgent?
  sessions               ConversationSession[]
  staff_calls            StaffCall[]
  owner                  Owner? // PHASE 12: Unified ownership
  builder_leads          BuilderLead[] // PHASE 12: Builder project leads
  demand_transactions    Transaction[]           @relation("DemandTransactions")
  supply_transactions    Transaction[]           @relation("SupplyTransactions")
  work_tasks             Task[] // SSOT: Work tasks (project management) linked to this contact
  property_shares        PropertyShare[] // Properties shared with this contact
  saved_properties       SavedProperty[] // Properties saved/favorited by this contact
  shortlisted_properties LeadPropertyShortlist[] // Properties in lead's consideration journey

  // Contact Attribution (who created this contact -- determines visibility)
  // null = auto-created by system (inbound WhatsApp/website/portal) -> owned by super_boss
  created_by       String? // Agent.id who created this contact
  created_by_agent Agent?  @relation("ContactCreatedBy", fields: [created_by], references: [id])

  // Owning manager — the internal agent responsible for this contact's end-to-end coordination.
  // Differs from created_by when contact is created on behalf of a partner agent — in that case
  // owning_manager_id inherits from the referral partner's managing_agent_id.
  // null => owned by super_boss (system fallback). See OwnershipService.
  owning_manager_id String?
  owning_manager    Agent?  @relation("ContactOwningManager", fields: [owning_manager_id], references: [id])

  leads Lead[] // All demand requirements ever made by this contact

  // Canonical taxonomy (Phase 1a) — buyer's demand type node; backfilled in 1b.
  taxonomy_node_id      String?
  taxonomy_node         TaxonomyNode? @relation(fields: [taxonomy_node_id], references: [id])
  needs_taxonomy_review Boolean       @default(false)

  @@index([tenant_id, phone_number])
  @@index([contact_type])
  @@index([lead_status])
  @@index([lifecycle_stage])
  @@index([next_action_at])
  @@index([contact_type, lead_status])
  @@index([last_interaction])
  @@index([assigned_agent_id])
  @@index([created_by])
  @@index([owning_manager_id])
  @@map("contacts")
}

enum ContactType {
  BUYER // Was BUYER_TENANT - looking to purchase a property
  TENANT // Was BUYER_TENANT - looking to rent a property
  LANDLORD // Was SELLER_LANDLORD - property owner (can sell or rent)
  PARTNER_AGENT // External broker/dealer
  REAL_ESTATE_BUILDER // Builder with projects
  MANAGEMENT // Internal team member
  UNKNOWN // Not yet classified (default for all inbound)
}

// ---------------------------------------------------------
// 3. INTERACTIONS (Unified Log)
// ---------------------------------------------------------
model Interaction {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  channel    String // whatsapp, voice, email, website
  direction  String // inbound, outbound
  event_type String // message, call, form_submit

  content  String? @db.Text
  metadata Json? // duration, message_id, etc.

  created_at DateTime @default(now())

  @@index([tenant_id, phone_number, created_at])
  @@index([channel, direction, created_at])
  @@map("interactions")
}

// ---------------------------------------------------------
// 4. WHATSAPP MESSAGES
// ---------------------------------------------------------
model WhatsAppMessage {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  wa_message_id String? @unique
  direction     String // inbound, outbound
  message_type  String // text, image, template
  body          String? @db.Text
  media_url     String?
  status        String  @default("sent") // sent, delivered, read, failed

  created_at DateTime @default(now())

  @@map("whatsapp_messages")
}

// ---------------------------------------------------------
// 5. VOICE CALLS
// ---------------------------------------------------------
model VoiceCall {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  call_sid        String? @unique
  direction       String // inbound, outbound
  call_status     String // answered, missed, failed
  duration        Int? // seconds
  recording_url   String?
  transcript      String? @db.Text
  ai_call_summary String? @db.Text

  started_at DateTime  @default(now())
  ended_at   DateTime?

  @@map("voice_calls")
}

// ---------------------------------------------------------
// 6. EMAILS
// ---------------------------------------------------------
model Email {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  phone_number String?
  contact      Contact? @relation(fields: [phone_number], references: [phone_number])

  // Email Addresses
  from_email String
  to_email   String
  cc         String? @db.Text // Comma-separated
  bcc        String? @db.Text // Comma-separated

  // Content
  subject String?
  body    String? @db.Text
  html    String? @db.Text

  // Direction & Status
  direction String // inbound, outbound
  status    String @default("pending") // pending, sent, delivered, failed, bounced

  // Email Metadata
  message_id  String? @unique
  in_reply_to String? // For threading
  references  String? // Email thread references
  attachments Json? // Array of attachment URLs

  // AI Processing
  ai_processed  Boolean @default(false)
  ai_response   String? @db.Text
  ai_confidence Float?

  // Timestamps
  sent_at      DateTime?
  delivered_at DateTime?
  opened_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([from_email])
  @@index([to_email])
  @@index([message_id])
  @@index([created_at])
  @@map("emails")
}

// ---------------------------------------------------------
// 7. TASKS & FOLLOWUPS
// ---------------------------------------------------------
model TaskFollowup {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  task_type    String // call, whatsapp, site_visit
  status       String    @default("pending") // pending, completed, skipped
  scheduled_at DateTime
  executed_at  DateTime?

  created_at DateTime @default(now())

  @@index([scheduled_at, status])
  @@map("tasks_followups")
}

// ---------------------------------------------------------
// 8. AGENTS (Human)
// ---------------------------------------------------------
model Agent {
  id        String @id @default(uuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  name           String
  email          String  @unique
  phone          String? // Required for new members; nullable for backward compat
  personal_email String? // Personal Gmail - used for SubUserName matching from 99acres

  // Per-member outbound email config (T9b, 2026-05-16). When set, this agent's
  // emails are sent via their own mailbox (e.g. Outlook/Office365) instead of the
  // shared Postfix relay. App password stored AES-256-GCM encrypted (utils/crypto).
  email_provider      String?
  email_smtp_host     String?
  email_smtp_port     Int?
  email_smtp_secure   Boolean?
  email_smtp_username String?
  email_smtp_password String? // AES-256-GCM ciphertext — never returned to client
  email_configured_at DateTime?
  // True once the member has set their OWN @realtypandit.in mailbox password
  // (self-service activation, 2026-05-19). Until then the profile shows
  // "activate your email — set your password" instead of the Outlook config.
  email_mailbox_activated Boolean @default(false)

  // Per-member Google account link (2026-05-18) — reminders/visits sync to the
  // member's own Google Calendar + Tasks, and Google Sign-In. Refresh token is
  // AES-256-GCM ciphertext via utils/crypto. See docs/plans/2026-05-18-google-calendar-task-reminder-sync.md
  google_email         String?
  google_refresh_token String? // AES-256-GCM ciphertext — never returned to client
  google_connected_at  DateTime?
  google_sync_enabled  Boolean  @default(true)

  role           String  @default("employee") // super_boss, manager, employee
  department     String? // property_sales, operations, management, software_sales
  status         String  @default("active")
  gender             String @default("unknown") // male, female, unknown
  preferred_language String @default("hi_en")   // hi, en, hi_en — auto-learned from voice calls

  // Authentication
  password_hash       String?
  refresh_token       String?
  last_login_at       DateTime?
  setup_token         String?   @unique
  setup_token_expires DateTime?

  // Management Hierarchy
  reports_to_id String?
  reports_to    Agent?  @relation("AgentHierarchy", fields: [reports_to_id], references: [id])
  subordinates  Agent[] @relation("AgentHierarchy")

  assigned_leads           Contact[]
  assigned_properties      Inventory[]     @relation("AssignedProperties")
  uploaded_inventory       Inventory[]     @relation("UploadedInventory")
  reference_inventory      Inventory[]     @relation("ReferenceInventory")
  staff_calls              StaffCall[]
  appointments             Appointment[] // Calendar system appointments
  executive_transactions   Transaction[]   @relation("ExecutiveTransactions")
  coordinated_transactions Transaction[]   @relation("CoordinatorTransactions")
  managed_partners         PartnerAgent[]  @relation("ManagedPartners")
  property_shares          PropertyShare[] // Properties shared by this agent with clients
  created_contacts         Contact[]       @relation("ContactCreatedBy")
  assigned_leads_new       Lead[]          @relation("LeadAssignments")
  created_leads            Lead[]          @relation("LeadCreatedBy")

  // Ownership relations (2026-04-17 middleman model)
  owned_contacts           Contact[]       @relation("ContactOwningManager")
  owned_inventory          Inventory[]     @relation("InventoryOwningManager")
  owned_transactions       Transaction[]   @relation("TransactionOwningManager")
  commission_entries_made  DealCommissionEntry[] @relation("CommissionEnteredBy")
  commission_entries_received DealCommissionEntry[] @relation("CommissionAgentPayee")
  partner_reassignments_done PartnerReassignmentLog[] @relation("PartnerReassignPerformedBy")
  partner_reassignments_to   PartnerReassignmentLog[] @relation("PartnerReassignToAgent")
  team_actions               TeamAction[]             @relation("AgentTeamActions")
  partner_reassignments_from PartnerReassignmentLog[] @relation("PartnerReassignFromAgent")

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  last_assigned_at DateTime? // Round-robin lead distribution tracking

  @@index([role, status, last_assigned_at])
  @@map("agents")
}

// ---------------------------------------------------------
// 9. INVENTORY (Properties) - EXTENDED FOR MARKETPLACE
// ---------------------------------------------------------
model Inventory {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // PHASE 12: Unified ownership model
  // Owner can be INTERNAL (staff-managed) or EXTERNAL (agent/builder)
  owner_id String
  owner    Owner  @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  // Legacy: Keep owner_phone for backward compatibility with direct contact lookup
  owner_phone String
  contact     Contact @relation(fields: [owner_phone], references: [phone_number])

  // --- ASSIGNMENT & KEY MANAGEMENT ---
  // Internal sales agent assigned to handle this property
  assigned_agent_id String?
  assigned_agent    Agent?  @relation("AssignedProperties", fields: [assigned_agent_id], references: [id])

  // Key holder contact (person who holds the physical keys)
  key_holder_contact_id String?
  key_holder_contact    Contact? @relation("KeyHolderProperties", fields: [key_holder_contact_id], references: [phone_number])

  // Key holder details (who physically holds the property key)
  key_holder_type  KeyHolderType?
  key_holder_name  String? // Name of key holder (for EXTERNAL type)
  key_holder_phone String? // Phone of key holder (for EXTERNAL type)

  // Owner contact ID (for easy reference, already have owner_phone)
  owner_contact_id String?
  owner_contact    Contact? @relation("OwnedProperties", fields: [owner_contact_id], references: [phone_number])

  // --- HIERARCHICAL CLASSIFICATION (PHASE 7) ---
  category_id        String?
  sub_category_id    String?
  type_id            String?
  configuration_id   String?
  usage_type_id      String?
  investment_type_id String?

  property_category      PropertyCategory?      @relation(fields: [category_id], references: [id])
  property_sub_category  PropertySubCategory?   @relation(fields: [sub_category_id], references: [id])
  property_type_link     PropertyType?          @relation(fields: [type_id], references: [id])
  property_configuration PropertyConfiguration? @relation(fields: [configuration_id], references: [id])
  usage_type             UsageType?             @relation(fields: [usage_type_id], references: [id])
  investment_type        InvestmentType?        @relation(fields: [investment_type_id], references: [id])

  // Legacy fields (kept for backward compatibility, will be DEPRECATED)
  category String // residential, commercial
  type     String // flat, house, plot, office, shop

  // Specs — SINGLE SOURCE OF TRUTH for all type-specific property fields keyed by
  // FieldDefinition.key from the taxonomy schema. Includes bhk / rooms / bathrooms /
  // area / area_unit / furnishing / facing / age-of-construction / floors /
  // amenities (array of label strings) / additional-rooms / parking / etc.
  // See PROJECT_STATUS 2026-05-28 "Specs unification" for the dedup history.
  specs    Json?

  // Property Details — only non-type-specific scalar fields. furnishing / facing /
  // property_age / total_floors / features were retired in Phase 4 (2026-05-28); they
  // live in specs.* now under canonical taxonomy keys.
  description  String? @db.Text // Free-text property description
  floor_number Int?

  // Structured Address
  flat_no        String? // "A-1201", "B-304"
  plot_no        String? // "Plot 42" or building name
  apartment_name String? // "Gaur City 2", "ATS Pristine"
  state          String? // Indian state: "Uttar Pradesh"
  district       String? // City/District: "Gautam Buddh Nagar"
  sub_locality   String? // Sub-locality/neighborhood: "Sector 150", "Bani Park"
  locality       String? // Locality/Area: "Noida", "Greater Noida"
  pincode        String? // 6-digit: "201310"
  full_address   String? // Computed: "Sector 150, Gautam Buddh Nagar, Uttar Pradesh - 201310"

  location String? // Legacy: kept for backward compat, auto-populated from structured fields

  // Geo-coordinates for Google Maps integration
  latitude  Float? // Geocoded latitude for map pins
  longitude Float? // Geocoded longitude for map pins

  price      Decimal?
  price_unit String? // Lakh, Crore/Cr

  // --- DUAL PRICING (Redesign v2) ---
  customer_price Decimal? // Owner's actual asking price (internal only, never shown publicly)
  display_price  Decimal? // Price shown on website (our price to showcase)

  // --- CITY (replaces district label, both kept for backward compat) ---
  city String? // City name (user-facing label for district)

  status String @default("active") // active, sold, rented, withdrawn
  intent String // sell, rent, rent_lease, lease

  media_urls  String[] // Array of URLs
  video_urls  String[] // Array of video URLs
  media_score Int      @default(0) // 2=video+images, 1=images only, 0=no media (for sort ordering)

  lead_reference String? // Who referred this lead/property (e.g. "Agent Rakesh told about this")

  // --- FLAT PROPERTY TYPE (Redesign v2 - replaces hierarchical classification) ---
  flat_property_type_id String?
  flat_property_type    FlatPropertyType? @relation(fields: [flat_property_type_id], references: [id])

  // --- OWNERSHIP & UPLOAD TRACKING (Redesign v2) ---
  ownership_type OwnershipType? // OWNER, EXTERNAL_AGENT, AGENT_OWNER
  upload_source  String? // website, admin, whatsapp, voice, mobile_app
  uploader_phone String? // Phone of the person who uploaded (may differ from owner)
  uploader_name  String? // Name of the uploader
  uploader_email String? // Email of the uploader (for website users)

  // Who uploaded this inventory record (for visibility/audit)
  uploaded_by_agent_id String?
  uploaded_by_agent    Agent?  @relation("UploadedInventory", fields: [uploaded_by_agent_id], references: [id])

  // Reference agent who provided the lead (for AGENT_OWNER workflow)
  reference_agent_phone String? // Phone number of agent who gave this property
  reference_agent_id    String?
  reference_agent       Agent?  @relation("ReferenceInventory", fields: [reference_agent_id], references: [id])

  // --- PARTNER SOURCE + OWNING MANAGER (2026-04-17 middleman model) ---
  // If this inventory came from a partner agent, link it so ownership/visibility can be
  // resolved at query time. Matches the pattern on Contact/Lead.referral_partner_id.
  referral_partner_id String?
  referral_partner    PartnerAgent? @relation("InventoryReferralPartner", fields: [referral_partner_id], references: [id])

  // Owning manager — the internal agent responsible for this listing's coordination.
  // For partner-referred inventory: inherits from referral_partner.managing_agent_id.
  // For admin-uploaded: the admin user who submitted it (or their manager).
  // null => owned by super_boss (system fallback).
  owning_manager_id String?
  owning_manager    Agent?  @relation("InventoryOwningManager", fields: [owning_manager_id], references: [id])

  // --- SHARING & COLLABORATION ---
  shared_with_ids String[] // Agent IDs this inventory is shared with for collaboration

  // --- DISPLAY ID, SLUG & ENRICHMENT (v3 - Shortened Flow) ---
  display_id     String? @unique // Human-readable ID: RP-DEL-RES-20431
  slug           String? @unique // SEO-friendly URL slug: 2bhk-flat-sector-150-noida
  completion_pct Int     @default(0) // How complete is the listing (0-100)
  is_enriched    Boolean @default(false) // Whether post-save enrichment was done
  renovated      Boolean @default(false) // Property has been renovated
  // Pre-rented (pre-lease): a FOR-SALE property that already has a sitting tenant paying rent.
  pre_rented              Boolean  @default(false) // For-sale property already tenanted
  pre_rented_monthly_rent Decimal? // Current monthly rent the sitting tenant pays

  documents        InventoryDocument[] // Attached documents (title deed, NOC, etc.)
  appointments     Appointment[] // Calendar system appointments
  transactions     Transaction[] // Deal transactions involving this property
  work_tasks       Task[] // SSOT: Work tasks (project management) linked to this property
  property_shares  PropertyShare[] // Shares of this property with clients
  saved_properties SavedProperty[] // Users who saved/favorited this property
  shortlisted_by   LeadPropertyShortlist[] // Leads considering this property

  // Canonical taxonomy (Phase 1a) — leaf type node; backfilled in 1b. Legacy classification kept in sync.
  taxonomy_node_id      String?
  taxonomy_node         TaxonomyNode? @relation(fields: [taxonomy_node_id], references: [id])
  needs_taxonomy_review Boolean       @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([location])
  @@index([owner_id])
  @@index([uploaded_by_agent_id])
  @@index([reference_agent_id])
  @@index([category_id, sub_category_id, type_id])
  @@index([status, intent, created_at])
  @@index([status, price])
  @@index([state, district])
  @@index([city])
  @@index([flat_property_type_id])
  @@index([latitude, longitude]) // Spatial indexing for map queries
  @@index([display_id])
  @@index([slug])
  @@index([shared_with_ids]) // GIN index for array contains queries
  @@index([referral_partner_id])
  @@index([owning_manager_id])
  @@map("inventory")
}

enum KeyHolderType {
  UPLOADER // The agent who uploaded holds the key
  OWNER // The property owner holds the key
  EXTERNAL // An external agent/dealer holds the key
}

enum OwnershipType {
  OWNER // Property owner directly uploading
  EXTERNAL_AGENT // External dealer listing on behalf of owner
  AGENT_OWNER // Internal team agent who also owns the property
}

// ---------------------------------------------------------
// 9a. INVENTORY DOCUMENTS (Title deeds, NOC, layouts, etc.)
// ---------------------------------------------------------
model InventoryDocument {
  id           String    @id @default(uuid())
  inventory_id String
  inventory    Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade)

  doc_type  String // title_deed, noc, layout_plan, sale_agreement, encumbrance, tax_receipt, other
  title     String // User-given label: "NOC from Builder"
  file_url  String // Storage path
  file_name String // Original filename
  mime_type String // application/pdf, image/jpeg, etc.
  file_size Int? // Bytes

  uploaded_via String   @default("web") // web, admin, whatsapp
  created_at   DateTime @default(now())

  @@index([inventory_id])
  @@map("inventory_documents")
}

// ---------------------------------------------------------
// 9a2. INVENTORY COUNTER (Sequential display ID generation)
// ---------------------------------------------------------
model InventoryCounter {
  id         String   @id @default("singleton")
  counter    Int      @default(20000)
  updated_at DateTime @updatedAt

  @@map("inventory_counters")
}

// ---------------------------------------------------------
// 9c. CANONICAL TAXONOMY (Phase 1a — single self-referential tree + per-type field schema)
// Source of truth = Chat/newtree.xlsx. Replaces the 3-tier hierarchy + FlatPropertyType
// over phases 1b-1d. Additive for now; legacy classification stays populated for back-compat.
// ---------------------------------------------------------
model TaxonomyNode {
  id            String         @id @default(uuid())
  parent_id     String?
  parent        TaxonomyNode?  @relation("NodeChildren", fields: [parent_id], references: [id])
  children      TaxonomyNode[] @relation("NodeChildren")
  name          String
  slug          String
  node_kind     String         // CATEGORY | SUBCATEGORY | GROUP | TYPE
  display_order Int            @default(0)
  is_active     Boolean        @default(true)
  labels_json   Json?
  // Phase 1d: legacy classification map (back-compat). Lets the add-inventory commit
  // derive the old flat_property_type / category / sub_category for a chosen TYPE node,
  // so matching/search/sharing keep working until Phases 2-5 retire the legacy columns.
  legacy_sub_category_id       String?
  legacy_type_id               String?
  legacy_flat_property_type_id String?
  node_fields   NodeField[]
  inventory     Inventory[]
  contacts      Contact[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  @@unique([parent_id, slug])
  @@index([parent_id])
  @@index([node_kind])
  @@map("taxonomy_nodes")
}

model FieldDefinition {
  id            String      @id @default(uuid())
  key           String      @unique
  label         String
  input_type    String      // number | select | multiselect | text | boolean | parking_list
  options_json  Json?
  unit          String?
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  node_fields   NodeField[]
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@map("field_definitions")
}

model NodeField {
  id               String          @id @default(uuid())
  taxonomy_node_id String
  node             TaxonomyNode    @relation(fields: [taxonomy_node_id], references: [id], onDelete: Cascade)
  field_id         String
  field            FieldDefinition @relation(fields: [field_id], references: [id], onDelete: Cascade)
  display_order    Int             @default(0)
  required         Boolean         @default(false)
  label_override   String?
  options_override Json?

  @@unique([taxonomy_node_id, field_id])
  @@index([taxonomy_node_id])
  @@map("node_fields")
}

// ---------------------------------------------------------
// 9b. FLAT PROPERTY TYPES (Redesign v2 - replaces hierarchical classification)
// Single-level list: 11 Residential + 25 Commercial + 1 Agricultural = 37 types
// ---------------------------------------------------------
model FlatPropertyType {
  id            String  @id @default(uuid())
  name          String // "Residential Apartment", "Commercial Shops", etc.
  slug          String  @unique
  main_category String // "residential", "commercial", "agricultural"
  icon          String?
  display_order Int     @default(0)
  is_active     Boolean @default(true)

  // Inline validation rules (no sub-category lookup needed)
  bhk_required       Boolean @default(false)
  floor_required     Boolean @default(false)
  plot_area_required Boolean @default(false)

  // Backward compatibility: maps to legacy hierarchy slugs
  legacy_category_slug String? // e.g., "residential"
  legacy_type_slug     String? // e.g., "flat"

  inventory Inventory[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([main_category, is_active])
  @@map("flat_property_types")
}

enum CallStatus {
  UPLOADING
  PROCESSING
  TRANSCRIBED
  READY_FOR_REVIEW
  APPROVED
  REJECTED
}

