// ---------------------------------------------------------
// 18. OWNER & SUBSCRIPTION MODELS (PHASE 12 - Marketplace Transformation)
// ---------------------------------------------------------

model Owner {
  id String @id @default(uuid())

  // Ownership Scope & Type
  scope        OwnerScope // INTERNAL or EXTERNAL
  externalType ExternalOwnerType? // Required if EXTERNAL

  // SSOT Link to Contact
  contact_phone String  @unique
  contact       Contact @relation(fields: [contact_phone], references: [phone_number], onDelete: Cascade)

  // Status & Limits
  status         OwnerStatus @default(PENDING_VERIFICATION)
  listing_limit  Int         @default(10)
  priority_score Int         @default(50)

  // Relations
  subscription Subscription?
  inventory    Inventory[]
  projects     Project[]
  commissions  Commission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([scope, externalType])
  @@index([status])
  @@map("owners")
}

enum OwnerScope {
  INTERNAL
  EXTERNAL
}

enum ExternalOwnerType {
  INDIVIDUAL_AGENT
  PROPERTY_AGENT
  REAL_ESTATE_BUILDER
}

enum OwnerStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING_VERIFICATION
}

model Subscription {
