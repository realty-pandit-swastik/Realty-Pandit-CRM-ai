model Commission {
  id String @id @default(uuid())

  // PHASE 12: Updated to reference unified Owner model
  owner_id String
  owner    Owner  @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  visit_id          String // Reference to ScheduledVisit or deal
  property_id       String
  transaction_id    String? // Link to Transaction (deal)
  deal_value        Decimal? // Final deal amount
  commission_rate   Decimal  @default(2.0) // Percentage (e.g., 2%)
  commission_amount Decimal? // Calculated amount

  status  String    @default("PENDING") // PENDING, APPROVED, PAID, DISPUTED
  paid_at DateTime?

  notes String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_id, status])
  @@map("commissions")
}

// ---------------------------------------------------------
// 17. STAFF CALL INTELLIGENCE (PHASE 8)
// ---------------------------------------------------------
model StaffCall {
  id String @id @default(uuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // Staff agent who made/received the call
  staff_agent_id String
  staff_agent    Agent  @relation(fields: [staff_agent_id], references: [id])

  // Contact phone number (business call)
  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  // Recording & Transcript
  recording_url String? // Cloud storage URL
  duration      Int? // seconds
  transcript    String? @db.Text

