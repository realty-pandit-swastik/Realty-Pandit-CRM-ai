// Notification Preferences - Persist per agent/partner (replaces hardcoded defaults)
model NotificationPreference {
  id String @id @default(uuid())

  // Polymorphic owner: either an Agent or PartnerAgent
  owner_type String // agent, partner
  owner_id   String

  // Channel preferences
  whatsapp_enabled Boolean @default(true)
  email_enabled    Boolean @default(true)

  // Event-specific preferences (flexible JSON)
  // Example: { "deal_status_change": true, "visit_scheduled": true, "query_raised": true }
  event_preferences Json @default("{}")

  // Quiet hours
  quiet_hours_enabled Boolean @default(true)
  quiet_hours_start   String  @default("21:00")
  quiet_hours_end     String  @default("08:00")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([owner_type, owner_id])
  @@map("notification_preferences")
}

// ---------------------------------------------------------
// NOTIFICATIONS (In-app + Push + audit trail for all channels)
// ---------------------------------------------------------
model Notification {
  id             String   @id @default(uuid())
  tenant_id      String
  recipient_id   String // agent ID, partner agent ID, or contact phone
  recipient_type String // "agent" | "partner" | "contact"
  event          String // e.g. "inventory_approved", "lead_assigned"
  category       String // "inventory" | "lead" | "deal" | "appointment" | "task" | "team" | "system"
  title          String
  body           String
  data           Json? // event-specific payload (inventory_id, lead_phone, etc.)
  action_url     String? // deep link for click-to-navigate (e.g. "#/inventory?id=xxx")
  channels_sent  String[] // which channels delivered: ["whatsapp","email","push"]
  read           Boolean  @default(false)
  clicked        Boolean  @default(false)
  created_at     DateTime @default(now())

  @@index([recipient_id, read])
  @@index([recipient_id, created_at])
  @@index([event])
  @@map("notifications")
}

model PushSubscription {
  id          String   @id @default(uuid())
  agent_id    String
  endpoint    String   @unique
  keys_p256dh String
  keys_auth   String
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([agent_id])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------
// PROPERTY SHARES (Track client-facing property shares)
// ---------------------------------------------------------
model PropertyShare {
  id        String @id @default(uuid())
  tenant_id String

  inventory_id String
  inventory    Inventory @relation(fields: [inventory_id], references: [id])

  agent_id String
  agent    Agent  @relation(fields: [agent_id], references: [id])

  client_phone String
  contact      Contact @relation(fields: [client_phone], references: [phone_number])

  channel       String // whatsapp_api, link_copy, email, sms
  property_link String
  whatsapp_sent Boolean @default(false)
  link_clicked  Boolean @default(false)

  created_at DateTime @default(now())

  @@index([inventory_id])
  @@index([agent_id])
  @@index([client_phone])
  @@index([created_at])
  @@index([tenant_id, created_at])
  @@map("property_shares")
}

// ---------------------------------------------------------
// SAVED PROPERTIES (Favorites / Shortlist)
// Tracks which contacts saved/favorited which properties
// ---------------------------------------------------------
model SavedProperty {
  id String @id @default(uuid())

  tenant_id String

  contact_id String
  contact    Contact @relation(fields: [contact_id], references: [phone_number])

  inventory_id String
  inventory    Inventory @relation(fields: [inventory_id], references: [id])

  source String @default("website") // website, whatsapp, share

  created_at DateTime @default(now())

  @@unique([contact_id, inventory_id])
  @@index([inventory_id])
  @@index([contact_id])
  @@map("saved_properties")
}

// ---------------------------------------------------------
// IntegrationSync - tracks polling state for external APIs
// ---------------------------------------------------------
model IntegrationSync {
  id                   String    @id @default(uuid())
  source               String    @unique // '99acres', 'magicbricks', etc.
  status               String    @default("idle") // idle | running | success | failed
  last_success         DateTime?
  last_attempt         DateTime?
  last_error           String?
  leads_fetched        Int       @default(0)
  leads_new            Int       @default(0)
  leads_updated        Int       @default(0)
  total_syncs          Int       @default(0)
  consecutive_failures Int       @default(0)
  metadata             Json?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@map("integration_syncs")
}

// ---------------------------------------------------------
// 40. DEAL COMMISSION ENTRIES (2026-04-17 — middleman model)
// Manual post-close capture of per-party earnings. No rigid splits enforced.
// ---------------------------------------------------------
model DealCommissionEntry {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  // Who earned this slice
  party_type       CommissionPartyType
  agent_id         String? // Set when party_type = INTERNAL_AGENT
  agent            Agent?  @relation("CommissionAgentPayee", fields: [agent_id], references: [id])
  partner_agent_id String? // Set when party_type = PARTNER_AGENT
  partner_agent    PartnerAgent? @relation("CommissionPartnerPayee", fields: [partner_agent_id], references: [id])

  // Amount + metadata
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")
  notes    String? @db.Text

  // Audit
  entered_by_agent_id String
  entered_by_agent    Agent    @relation("CommissionEnteredBy", fields: [entered_by_agent_id], references: [id])
  entered_at          DateTime @default(now())

  @@index([transaction_id])
  @@index([agent_id])
  @@index([partner_agent_id])
  @@map("deal_commission_entries")
}

enum CommissionPartyType {
  INTERNAL_AGENT
  PARTNER_AGENT
  PLATFORM
}

// ---------------------------------------------------------
// 41. PARTNER REASSIGNMENT LOG (2026-04-17 — middleman model)
// Audit trail of super_boss reassigning partner agents between internal managers.
// ---------------------------------------------------------
model PartnerReassignmentLog {
  id               String @id @default(uuid())
  partner_agent_id String
  partner_agent    PartnerAgent @relation(fields: [partner_agent_id], references: [id])

  from_agent_id String?
  from_agent    Agent?  @relation("PartnerReassignFromAgent", fields: [from_agent_id], references: [id])

  to_agent_id String
  to_agent    Agent  @relation("PartnerReassignToAgent", fields: [to_agent_id], references: [id])

  performed_by_agent_id String
  performed_by_agent    Agent  @relation("PartnerReassignPerformedBy", fields: [performed_by_agent_id], references: [id])

  reason     String?  @db.Text
  created_at DateTime @default(now())

  @@index([partner_agent_id])
  @@index([to_agent_id])
  @@map("partner_reassignment_logs")
}
