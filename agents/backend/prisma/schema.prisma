  unsubscribed_at DateTime?

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------
// 15. SCHEDULED VISITS (Property Site Visits) - EXTENDED
// ---------------------------------------------------------
model ScheduledVisit {
  id String @id @default(uuid())

  // Link to Contact (SSOT pattern)
  contact_id String
  contact    Contact @relation(fields: [contact_id], references: [phone_number])

  property_id    String
  name           String?
  phone          String?
  email          String?
  preferred_date DateTime?
  preferred_time String?
  message        String?
  source         String? // website_chat, website_form, whatsapp, voice, manual

  status String @default("pending") // pending, confirmed, completed, cancelled

  // Agent appointment tracking
  agent_id            String? // If property belongs to external agent
  internal_handler_id String? // Assigned internal staff for coordination
  buyer_info_masked   Boolean @default(false) // TRUE for FREE agent appointments

  metadata Json? // Session ID, booking details, etc.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([contact_id])
  @@index([property_id])
  @@index([agent_id])
  @@map("scheduled_visits")
}

// ---------------------------------------------------------
// CALENDAR APPOINTMENTS (Unified Calendar System)
// ---------------------------------------------------------
model Appointment {
  id String @id @default(uuid())

  // Link to Contact (SSOT pattern)
  contact_id String
  contact    Contact @relation(fields: [contact_id], references: [phone_number])

  // Appointment Details
  title       String
  description String?         @db.Text
  type        AppointmentType // property_visit, follow_up_call, meeting, site_visit, documentation, other

  // Date & Time
  scheduled_at DateTime
  duration     Int       @default(30) // Duration in minutes
  end_time     DateTime? // Calculated or manually set

  // Assignment (Who handles this appointment)
  assigned_to_agent_id String? // Internal agent/staff handling appointment
  assigned_to_agent    Agent?  @relation(fields: [assigned_to_agent_id], references: [id])

  // Property linkage (if applicable) - Builders/External agents access via property ownership
  property_id String?
  property    Inventory? @relation(fields: [property_id], references: [id])

  // Transaction linkage (for deal-linked appointments)
  transaction_id String?
  transaction    Transaction? @relation("TransactionAppointments", fields: [transaction_id], references: [id])

  // Status Management
  status  AppointmentStatus @default(scheduled)
  source  String? // website_chat, whatsapp, voice, manual, ai_bot
  channel String? // whatsapp, voice, website

  // WhatsApp Integration
  reminder_sent         Boolean   @default(false)
  reminder_sent_at      DateTime?
  confirmation_received Boolean   @default(false)
  whatsapp_message_id   String?

  // Location (for physical meetings)
  location String?

  // Additional context
  notes    String? @db.Text
  metadata Json? // Session ID, booking details, AI context, etc.

  // Tenant
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([contact_id])
  @@index([assigned_to_agent_id])
  @@index([property_id])
  @@index([transaction_id])
  @@index([scheduled_at])
  @@index([status])
  @@map("appointments")
}

enum AppointmentType {
  property_visit
  follow_up_call
  meeting
  site_visit
  documentation
  negotiation
  contract_signing
  handover
  other
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  rescheduled
  no_show
}

// ---------------------------------------------------------
// 16. COMMISSIONS (For FREE Agents Only)
