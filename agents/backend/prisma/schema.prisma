// ---------------------------------------------------------
// 10. PARTNER AGENTS (External Marketplace Agents)
// ---------------------------------------------------------
model PartnerAgent {
  id           String  @id @default(uuid())
  phone_number String  @unique
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

  name         String
  email        String?
  company_name String?
  city         String?

  // Subscription & Package
  package_type AgentPackage @default(FREE)
  status       AgentStatus  @default(ACTIVE)

  // Listing Limits
  listing_limit  Int @default(10) // FREE=10, PRO=50, ADVANCE_PRO=unlimited (999)
  priority_score Int @default(50) // Used in matching ranking

  // Subscription Dates
  subscription_start DateTime?
  subscription_end   DateTime?

  // Legacy fields (keep for backward compatibility)
  agency_name     String?
  partner_type    String? // HAS_PROPERTIES, HAS_BUYERS, BOTH
  verified        Boolean  @default(false)
  commission_rate Decimal?

  // Partner category (individual vs company)
  partner_category PartnerCategory @default(INDIVIDUAL)

  // Managing internal agent (who onboarded & coordinates)
  managing_agent_id String?
  managing_agent    Agent?  @relation("ManagedPartners", fields: [managing_agent_id], references: [id])

  // Company hierarchy (sub-agents under a company partner)
  parent_partner_id String?
  parent_partner    PartnerAgent?  @relation("PartnerHierarchy", fields: [parent_partner_id], references: [id])
  sub_agents        PartnerAgent[] @relation("PartnerHierarchy")

  // Inventory referred by this partner (2026-04-17 middleman model)
  referred_inventory Inventory[] @relation("InventoryReferralPartner")

  // Commission entries where this partner was the payee
  commission_entries_received DealCommissionEntry[] @relation("CommissionPartnerPayee")

  // Reassignment audit trail
  reassignment_logs PartnerReassignmentLog[]

  // Mandatory business fields
  business_name       String?
  business_address    String?
  business_lat        Float?  // geo of the partner's location (Google Places autocomplete) — 2026-06-03
  business_lng        Float?
  registration_number String? // Udyam, GSTIN, etc.

  // Authentication
  password_hash String?

  // Onboarding metadata
  onboarded_by_agent_id String?
  onboarded_at          DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([phone_number])
  @@index([package_type, status])
  @@index([managing_agent_id])
  @@index([parent_partner_id])
  @@map("partner_agents")
}

enum AgentPackage {
  FREE
  PRO
  ADVANCE_PRO
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING_PAYMENT
}

enum PartnerCategory {
  INDIVIDUAL
  COMPANY
}

// ---------------------------------------------------------
// 11. LEAD SCORING
// ---------------------------------------------------------
model LeadScore {
  phone_number String @id
  tenant_id    String

  intent_score      Int @default(0)
  engagement_score  Int @default(0)
  reliability_score Int @default(0)
  urgency_score     Int @default(0)

  total_score Int @default(0)

  // Anti-Pattern Metrics
  no_show_count   Int       @default(0)
  last_no_show_at DateTime?

  last_updated_at DateTime @updatedAt

  contact Contact @relation(fields: [phone_number], references: [phone_number])

  lead_id String? @unique
  lead    Lead?   @relation("LeadScore", fields: [lead_id], references: [id])

  @@map("lead_scores")
}

// ---------------------------------------------------------
// LEADS (Demand Requirements - Separated from Contact)
// One Contact can have multiple Leads over time
// ---------------------------------------------------------
model Lead {
  id        String @id @default(uuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // SSOT link to Contact
  contact_phone String
  contact       Contact @relation(fields: [contact_phone], references: [phone_number])

  // Intent
  intent String? // "buy" | "rent" | null = not yet determined
  source String @default("manual") // whatsapp, website, 99acres, manual, etc.

  // Demand Requirements
  budget_min           Decimal?
  budget_max           Decimal?
  // Demand columns DROPPED Phase 5 (2026-05-29) — see Contact for rationale.
  //   demand_bhk Int? / demand_main_category / demand_type_slug / demand_amenities Json?
  demand_budget_type   String? // "one_time" | "per_month"

  // Demand-side unification (2026-05-29) — see Contact model for rationale.
  demand_taxonomy_node_id String? // null = "any property type"
  demand_schema_values    Json?   // keyed by FieldDefinition.key
  area_min             Float?
  area_max             Float?
  area_unit            String? // "sqft" | "sqmtr"

  // Classification IDs
  category_id     String?
  sub_category_id String?
  type_id         String?

  // Geo preference
  preferred_location String?
  preferred_lat      Float?
  preferred_lng      Float?

  // Lifecycle
  lead_status     String @default("cold") // cold, warm, hot, closed, lost
  lifecycle_stage String @default("NEW") // NEW, QUALIFIED, MATCHED, VISIT_SCHEDULED, VISITED, NEGOTIATION, CLOSED_WON, CLOSED_LOST

  // Assignment
  assigned_agent_id String?
  assigned_agent    Agent?  @relation("LeadAssignments", fields: [assigned_agent_id], references: [id])

  // Attribution
  created_by       String? // Agent.id who created this lead (null = auto from inbound)
  created_by_agent Agent?  @relation("LeadCreatedBy", fields: [created_by], references: [id])

  // Referral
  lead_type              String? // DIRECT_OWNER | PARTNER_REFERRAL
  referral_partner_id    String?
  referral_partner_name  String?
  referral_partner_phone String?

  // Verification
  verification_status  String?
  verification_reason  String?
  verification_remarks String?   @db.Text
  verified_by          String?
  verified_at          DateTime?

  // Meta Ad Attribution (when lead came from a Facebook/Instagram ad)
  meta_ad_id         String?
  meta_campaign_id   String?
  meta_campaign_name String?
  meta_ad_creative   String?
  meta_form_id       String?

  notes    String? @db.Text
  timeline String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lead_score LeadScore? @relation("LeadScore")

  @@index([contact_phone])
  @@index([tenant_id, lead_status])
  @@index([lifecycle_stage])
  @@index([assigned_agent_id])
  @@index([created_by])
  @@index([intent, lead_status])
  @@index([meta_campaign_id])
  @@map("leads")
}

// ---------------------------------------------------------
// 12. CONVERSATION SESSIONS (Persistent Workflow State)
// ---------------------------------------------------------
model ConversationSession {
  id           String  @id @default(uuid())
  phone_number String
  contact      Contact @relation(fields: [phone_number], references: [phone_number])

