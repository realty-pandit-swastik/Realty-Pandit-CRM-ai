  @@index([phone_number])
  @@index([agent_name])
  @@index([flagged])
  @@index([created_at])
  @@map("qa_logs")
}

// ---------------------------------------------------------
// 23. TRANSACTIONS (Property Deal Lifecycle)
// ---------------------------------------------------------

model Transaction {
  id        String @id @default(uuid())
  tenant_id String

  // The 4 Pillars: Demand + Supply + Executive + Inventory
  demand_contact_id  String // Buyer/Tenant phone (REQUIRED)
  supply_contact_id  String? // Seller/Landlord/Agent phone (null until matched)
  executive_agent_id String? // Internal sales executive (auto-assigned)
  inventory_id       String? // Property reference (null until matched)

  // PHASE 7: 3-Role Deal Structure
  demand_handler_type  String? // PARTNER, TEAM_MEMBER, DIRECT
  demand_handler_id    String? // PartnerAgent.id or Agent.id (null for DIRECT)
  supply_handler_type  String? // PARTNER, TEAM_MEMBER
  supply_handler_id    String? // PartnerAgent.id or Agent.id
  coordinator_agent_id String? // Always an internal Agent - the middleman
  deal_scenario        String? // PARTNER_INTERNAL, PARTNER_PARTNER, DIRECT_INTERNAL

  // Deal Details
  type     TransactionType // SALE or RENT
  status   TransactionStatus @default(NEW)
  priority Int               @default(0) // Higher = more important

  // Demand Requirements Snapshot (from buyer/tenant at creation).
  // Demand columns DROPPED Phase 5 (2026-05-29):
  //   demand_property_type / demand_bedrooms / demand_category / demand_type_slug / demand_amenities
  demand_location      String? // Preferred locality/city
  demand_budget_min    Float?
  demand_budget_max    Float?
  demand_notes         String? @db.Text

  // PHASE 7: Extended Requirements Snapshot (non-deprecated columns only).
  demand_intent      String? // buy, rent_lease
  demand_budget_type String? // one_time (buy), per_month (rent/lease)
  demand_area_min    Float? // Minimum desired area in sqft
  demand_area_max    Float? // Maximum desired area in sqft

  // Demand-side unification (2026-05-29) — canonical SoT for type-specific fields.
  demand_taxonomy_node_id String? // null = "any property type"
  demand_schema_values    Json?   // keyed by FieldDefinition.key

  // Visit Outcome (filled by lead manager on stage VISITED submission)
  visit_outcome          String? // Property Liked / Want More Properties / Re-match Required / No Show
  client_interest_level  String? // Hot / Warm / Cold
  visit_feedback         String? @db.Text // What did client say about the property
  workflow_round         Int     @default(1) // Increments on each re-visit cycle

  // Outcome (filled on close)
  final_price       Float? // Agreed price (on CLOSED_WON)
  close_reason      String? // Why closed (won or lost)
  commission_amount Float? // Commission earned

  // Metadata
  source          String             @default("whatsapp") // whatsapp, web, voice, admin
  previous_status TransactionStatus? // For ON_HOLD recovery

  // AI–Team coordination
  last_team_action_at DateTime? // set whenever a team member logs a manual action; crons back off
  ai_paused           Boolean   @default(false) // explicit team override; all automations skip

  // Owning manager — SSOT for "whose deal is this" for visibility/cascade purposes.
  // Usually equals coordinator_agent_id, but kept separate so reassignment/cascade can
  // update ownership without affecting the coordinator (who is the operational middleman).
  owning_manager_id String?
  owning_manager    Agent?  @relation("TransactionOwningManager", fields: [owning_manager_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  closed_at  DateTime?

  // Relations
  demand_contact  Contact    @relation("DemandTransactions", fields: [demand_contact_id], references: [phone_number])
  supply_contact  Contact?   @relation("SupplyTransactions", fields: [supply_contact_id], references: [phone_number])
  executive_agent Agent?     @relation("ExecutiveTransactions", fields: [executive_agent_id], references: [id])
  coordinator     Agent?     @relation("CoordinatorTransactions", fields: [coordinator_agent_id], references: [id])
  inventory       Inventory? @relation(fields: [inventory_id], references: [id])
  tenant          Tenant     @relation(fields: [tenant_id], references: [id])

  logs               TransactionLog[]
  appointments       Appointment[]          @relation("TransactionAppointments")
  queries            DealQuery[]
  commission_entries DealCommissionEntry[]
  team_actions       TeamAction[]

  @@index([demand_contact_id])
  @@index([supply_contact_id])
  @@index([executive_agent_id])
  @@index([coordinator_agent_id])
  @@index([inventory_id])
  @@index([status])
  @@index([tenant_id, status])
  @@index([deal_scenario])
  @@index([demand_handler_type, demand_handler_id])
  @@index([supply_handler_type, supply_handler_id])
  @@index([owning_manager_id])
  @@map("transactions")
}

model TransactionLog {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  action       TransactionLogAction
  old_status   TransactionStatus?
  new_status   TransactionStatus?
  performed_by String? // phone_number or agent_id of who triggered
  channel      String? // whatsapp, web, voice, system
  details      Json? // Flexible payload (notes, reason, metadata)

  created_at DateTime @default(now())

  @@index([transaction_id])
  @@index([action])
  @@index([created_at])
  @@map("transaction_logs")
}

model TeamAction {
  id             String   @id @default(cuid())
  tenant_id      String
  transaction_id String
  agent_id       String
  stage          String   // Pipeline stage when action was taken

  // Action type: CALLED | WHATSAPPED | CONFIRMED_VISIT | SCHEDULED_VISIT |
  //              REMINDER_GIVEN | LOGGED_NOTE | PAUSED_AI | RESUMED_AI |
  //              VISIT_RESCHEDULED | MEETING_BOOKED
  action_type    String

  // Outcome: connected | no_answer | busy | qualified | scheduled | reminder_given
  outcome        String?
  notes          String?  @db.Text

  created_at DateTime @default(now())

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  agent       Agent       @relation("AgentTeamActions", fields: [agent_id], references: [id])

  @@index([transaction_id])
  @@index([agent_id])
  @@index([created_at])
  @@map("team_actions")
}

enum TransactionType {
  SALE
  RENT
}

enum TransactionStatus {
  NEW
  QUALIFIED
  MATCHING_APPOINTMENT
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
  MATCHED // deprecated - migrate to QUALIFIED, kept to avoid breaking existing rows
}

enum RoleContext {
  DEMAND
  SUPPLY
  INTERNAL
}

enum TransactionLogAction {
  CREATED
  STATUS_CHANGED
  EXECUTIVE_ASSIGNED
  EXECUTIVE_CHANGED
  APPOINTMENT_LINKED
  APPOINTMENT_COMPLETED
  NEGOTIATION_UPDATE
  PARTY_NOTIFIED
  DUPLICATE_BLOCKED
  CLOSED
  REOPENED
  NOTE_ADDED
  FOLLOWUP_SENT
  OWNERSHIP_TRANSFERRED
}

// ---------------------------------------------------------
// 24. CAMPAIGNS (Marketing Agent - Broadcasts & Drip Campaigns)
// ---------------------------------------------------------

// Campaign Templates - Reusable message templates
model CampaignTemplate {
  id String @id @default(uuid())

  name     String // "Welcome Message", "Follow-up Reminder"
  channel  String // whatsapp, email, sms, voice
  category String? // welcome, followup, promotional, reminder, transactional

  // Template content
  subject   String? // For email
  body      String  @db.Text // Template with {{variables}}
  variables Json    @default("[]") // [{"name": "first_name", "required": true, "default": "Customer"}, ...]

  // Performance tracking
  avg_score      Float? // Average quality score from past usage
  times_used     Int    @default(0)
  avg_open_rate  Float? // For emails
  avg_reply_rate Float? // For WhatsApp

  created_by String? // Agent ID
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  campaigns Campaign[]

  @@index([channel])
  @@index([category])
  @@map("campaign_templates")
}

model Campaign {
  id String @id @default(uuid())

  name    String // "Noida Flat Launch", "Follow-up Wave 3"
  type    String @default("broadcast") // broadcast, drip, launch_promo, follow_up
  channel String @default("whatsapp") // whatsapp, email, voice

  // Template support (Phase 3.2)
  template_id String?
  template    CampaignTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  // Audience targeting (JSON filter criteria)
  audience Json? // {city: "Noida", budget_min: 5000000, contact_type: "BUYER_TENANT", property_type: "flat"}

  // Message content (can override template)
  message String  @db.Text
  subject String? // For email campaigns

  // Execution state
  status       String @default("draft") // draft, scheduled, sending, completed, cancelled
  sent_count   Int    @default(0)
  delivered    Int    @default(0)
  responded    Int    @default(0)
  failed_count Int    @default(0)

  // Scheduling & Recurrence (Phase 3.2)
  scheduled_at    DateTime?
  completed_at    DateTime?
  recurrence_rule String? // Cron format: "0 9 * * 1" (every Monday at 9am)

  // A/B Testing (Phase 3.2)
  ab_test_config Json? // {"enabled": true, "variants": [{"name": "A", "message": "...", "percentage": 50}, ...]}

  // Creator
  created_by String? // Agent ID who created this campaign

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([created_at])
  @@index([template_id])
  @@map("campaigns")
}

// ---------------------------------------------------------
// 24.5. PROJECTS & TASKS (Phase 3.3 - Task Management)
// ---------------------------------------------------------

model WorkProject {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD, CANCELLED
  start_date  DateTime  @default(now())
  end_date    DateTime?

  // Team assignment
  owner_id     String? // Agent ID
  team_members Json? // Array of agent IDs with access

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tasks Task[]

  @@index([status])
  @@index([owner_id])
  @@map("work_projects")
}

model Task {
  id String @id @default(uuid())

  // Project association (optional)
  project_id String?
  project    WorkProject? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  // Task details
  title       String
  description String?  @db.Text
  assigned_to String // Agent ID
  due_date    DateTime
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED

  // Contact/property association (SSOT Integration)
  contact_phone String?
  contact       Contact? @relation(fields: [contact_phone], references: [phone_number], onDelete: SetNull)

  property_id String?
  property    Inventory? @relation(fields: [property_id], references: [id], onDelete: SetNull)

  // Tags for categorization
  tags String[] // ["follow-up", "payment", "documentation"]

  // Workflow task extension
  task_type      String    @default("GENERAL") // GENERAL | QUALIFY_LEAD | SHARE_PROPERTIES | SCHEDULE_VISIT | VISIT_FEEDBACK | NEGOTIATE_DEAL
  snooze_count   Int       @default(0)
  snoozed_until  DateTime?
  workflow_stage Int? // 1-5 (null for GENERAL tasks)
  workflow_round Int       @default(1) // Loop iteration counter (for Stage 2-4 repeats)
  parent_task_id String? // Previous task in the chain
  deal_id        String? // FK to Transaction (linked after Stage 1)
  stage_metadata Json? // Stage-specific data (matches, feedback, shortlist snapshot, etc.)

  // Completion tracking
  completed_at DateTime?
  completed_by String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([assigned_to])
  @@index([status])
  @@index([due_date])
  @@index([project_id])
  @@index([contact_phone]) // SSOT: Index for contact lookup
  @@index([property_id]) // SSOT: Index for property lookup
  @@index([task_type, status]) // Workflow queue lookup
  @@index([deal_id])
  @@index([parent_task_id])
  @@index([contact_phone, task_type, status]) // Lead's active workflow tasks
  @@map("tasks")
}

// ---------------------------------------------------------
// 24b. LEAD PROPERTY SHORTLIST (Tracks properties through lead's consideration journey)
// ---------------------------------------------------------
model LeadPropertyShortlist {
  id        String @id @default(uuid())
  tenant_id String

  contact_phone String
  contact       Contact @relation(fields: [contact_phone], references: [phone_number])

  inventory_id String
  inventory    Inventory @relation(fields: [inventory_id], references: [id])

  deal_id String? // FK to Transaction

  // Lifecycle status: SHARED -> SHORTLISTED -> VISIT_SCHEDULED -> VISITED -> INTERESTED/REJECTED/REVISIT -> SELECTED
  status String @default("SHARED")

  // Tracking timestamps
  shared_at        DateTime  @default(now())
  shortlisted_at   DateTime?
  visited_at       DateTime?
  feedback         String? // Free text feedback from client
  rejection_reason String? // Why client rejected this property
  selected_at      DateTime?

  // Links to originating records
  property_share_id String? // FK to PropertyShare
  appointment_id    String? // FK to Appointment

  // Which workflow round introduced this property
  workflow_round Int @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([contact_phone, inventory_id, deal_id])
  @@index([contact_phone, status])
  @@index([deal_id, status])
  @@index([inventory_id])
  @@index([tenant_id])
  @@map("lead_property_shortlists")
}

// ---------------------------------------------------------
// 25. AUDIT REPORT (AI Boss - Daily Conversation Audit)
// ---------------------------------------------------------
model AuditReport {
  id          String   @id @default(uuid())
  report_date DateTime @default(now())

  // Audit findings
  total_conversations Int
  total_flagged       Int
  avg_quality_score   Float?

  issues_found    Json // [{category, count, severity, examples[], suggestion}]
  agent_breakdown Json? // {sales: {count, avg_score}, classifier: {...}, ...}
  sentiment_stats Json? // {positive: N, neutral: N, negative: N, frustrated: N}

  // Prompt Engineer actions
  actions_taken Json? // [{prompt_key, section, content, reason}]
  deployments   Int   @default(0)

  // Boss status
  email_sent    Boolean @default(false)
  email_sent_to String?

  created_at DateTime @default(now())

  @@index([report_date])
  @@map("audit_reports")
}

// ---------------------------------------------------------
// 26. PROMPT OVERRIDE (AI-Learned Rules - Runtime Prompt Injection)
// ---------------------------------------------------------
model PromptOverride {
  id String @id @default(uuid())

  prompt_key String // core_behavior, buyer_prompt, seller_prompt, identification, partner_prompt
  section    String // greeting_rules, language_rules, qualification_rules, response_format, classification_rules

  content  String  @db.Text // The override/addition text
  priority Int     @default(0) // Higher = applied later
  active   Boolean @default(true)

  // Audit trail
  reason          String? @db.Text
  audit_report_id String?
  deployed_by     String  @default("prompt_engineer_agent")
  version         Int     @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([prompt_key, active])
  @@index([created_at])
  @@map("prompt_overrides")
}

// ---------------------------------------------------------
// Pending WhatsApp Messages - Queue for LLM-generated messages
// awaiting session re-open (24h window expired)
// ---------------------------------------------------------
model PendingMessage {
  id           String   @id @default(uuid())
  phone_number String
  message      String   @db.Text
  context      String? // "followup", "ai_response", etc.
  status       String   @default("pending") // pending, sent, expired
  created_at   DateTime @default(now())
  expires_at   DateTime // Auto-expire after 48h

  @@index([phone_number, status])
  @@index([expires_at])
  @@map("pending_messages")
}

// ---------------------------------------------------------
// 27. WORKFLOW AUTOMATION (Phase 3.1)
// ---------------------------------------------------------
model Workflow {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Trigger configuration
  trigger String // LEAD_CREATED, STATUS_CHANGED, PROPERTY_ADDED, APPOINTMENT_SCHEDULED, APPOINTMENT_COMPLETED, INTERACTION_RECEIVED

  // Conditions (AND logic) - JSON array of {field, operator, value}
  // Example: [{"field": "lead_source", "operator": "equals", "value": "99acres"}, {"field": "budget", "operator": "greater_than", "value": "5000000"}]
  conditions Json @default("[]")

  // Actions (executed in order) - JSON array of {type, params}
  // Types: ASSIGN_AGENT, SEND_WHATSAPP, SEND_EMAIL, CREATE_TASK, UPDATE_STATUS, SEND_VOICE_CALL
  // Example: [{"type": "ASSIGN_AGENT", "params": {"agent_id": "xxx"}}, {"type": "SEND_WHATSAPP", "params": {"template": "welcome_message"}}]
  actions Json @default("[]")

  // Delay before execution (in minutes)
  delay_minutes Int @default(0) // 0 = immediate, 60 = 1 hour, 1440 = 1 day

  // Control flags
  enabled  Boolean @default(true)
  priority Int     @default(0) // Higher priority workflows execute first

  // Execution limits
  max_executions_per_day Int? // Prevent spam

  // Audit trail
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  executions WorkflowExecution[]

  @@index([trigger, enabled])
  @@index([enabled, priority])
  @@map("workflows")
}

model WorkflowExecution {
  id String @id @default(uuid())

  workflow_id String
  workflow    Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  // Trigger context (full event data at time of execution)
  trigger_data Json

  // Execution status
  status        String // SUCCESS, FAILED, SKIPPED, PENDING
  error_message String? @db.Text

  // Actions executed (JSON array of {type, status, result})
  actions_log Json @default("[]")

  // Performance tracking
  executed_at DateTime @default(now())
  duration_ms Int?

  @@index([workflow_id, status])
  @@index([executed_at])
  @@map("workflow_executions")
}

