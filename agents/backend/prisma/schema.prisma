  state    String // in_progress, awaiting_media, awaiting_documents, awaiting_confirm, awaiting_multi_select
  context  Json? // ConversationalSession data
  active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
  @@index([active, workflow])
  @@map("chat_workflow_sessions")
}

