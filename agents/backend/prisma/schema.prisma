  long_description  String? @db.Text

  // Listing Status
  status ProjectListingStatus @default(DRAFT)

  // Relations
  units        ProjectUnit[]
  media        ProjectMedia[]
  leads        BuilderLead[]
  appointments BuilderAppointment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_id])
  @@index([city, locality])
  @@index([status, project_status])
  @@map("projects")
