// ---------------------------------------------------------
// 21. AGENT ACTION LOG (Multi-Agent Audit Trail)
// ---------------------------------------------------------
model AgentActionLog {
  id String @id @default(uuid())

  agent_name String // master, sales, matching, appointment, etc.
  task_type  String // classify, match, schedule, follow_up, respond, etc.

  phone_number   String? // Contact involved (if any)
  input_summary  String? @db.Text // What the agent received
  output_summary String? @db.Text // What the agent returned

  quality_score Float? // QA agent's score (0-10), filled async
  duration_ms   Int? // How long the agent took (ms)

  status        String  @default("success") // success, failed, escalated
  error_message String? @db.Text

  created_at DateTime @default(now())

  @@index([agent_name])
  @@index([phone_number])
  @@index([created_at])
  @@index([status])
  @@index([agent_name, status, created_at])
  @@map("agent_action_logs")
}

// ---------------------------------------------------------
// 22. QA LOG (Quality Assurance Tracking)
// ---------------------------------------------------------
model QALog {
  id String @id @default(uuid())

  interaction_id String? // Reference to the Interaction being scored
  phone_number   String // Contact involved
  agent_name     String // Which agent produced this response

  quality_score Float // 0-10 (10 = perfect)
  issues        Json? // [{type: 'hallucination', detail: '...'}, {type: 'wrong_info', detail: '...'}]
  sentiment     String? // positive, neutral, negative, frustrated

  flagged     Boolean @default(false) // TRUE = needs human review
  reviewed_by String? // Agent (human) who reviewed this

