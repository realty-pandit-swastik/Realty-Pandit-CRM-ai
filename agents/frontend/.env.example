# ============================================================
# Realty Pandit Admin CRM — Environment Variables
# Copy this file to .env (development) or .env.production
# NEVER commit .env or .env.production to version control
# ============================================================

# Backend API URL
# For local development: http://localhost:7071
# For production: https://api.realtypandit.in
# REQUIRED — app will throw at startup if missing in production
VITE_API_BASE_URL=https://api.realtypandit.in

# Google Maps JavaScript API + Places API key
# Obtain from: https://console.cloud.google.com/google/maps-apis
# REQUIRED restrictions: HTTP referrers — admin.realtypandit.in/*, localhost:*
# REQUIRED APIs: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics 4 Measurement ID for the Admin CRM
# Create a NEW separate GA4 property at: https://analytics.google.com
# (Do NOT reuse G-WJF3Y3SXM3 — keep admin traffic isolated)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GlitchTip error monitoring DSN (optional but strongly recommended for production)
# Self-hosted at https://errors.realtypandit.in — Settings → Projects → Client Keys (DSN)
# Uses the Sentry SDK as the wire-compatible transport.
VITE_GLITCHTIP_DSN=

# Approved Chrome Web Store extension ID (32 lowercase a-p letters).
# Leave blank before store approval; the CRM shows publication pending.
VITE_PERSONAL_WHATSAPP_EXTENSION_ID=
